# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real values.

# Django signing key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# If unset, a throwaway key is generated at startup and sessions reset on restart.
DJANGO_SECRET_KEY=

# Debug tracebacks and static-file serving. Local development only.
# Must stay false anywhere the service is reachable from outside your machine.
DJANGO_DEBUG=true

# Comma-separated hostnames Django will answer for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
